[Unit]
Description=Official X API intelligence pipeline (daily one-shot)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/x-intelligence/.env

[Service]
Type=oneshot
User=xintel
Group=xintel
WorkingDirectory=/opt/x-intelligence
EnvironmentFile=/opt/x-intelligence/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/x-intelligence/index.mjs collect
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/x-intelligence/data /opt/x-intelligence/output
MemoryMax=384M
Nice=10
